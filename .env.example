# CPD Logger environment variables.
# Copy this file to .env.local and fill in what you need. Every value here is optional
# for trying the app locally: with everything blank it runs in local demo mode.
# Blank values count as "not set". Never commit .env.local.

# --- Supabase (leave blank for local demo mode) -------------------------------------
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for "Delete my account" in Supabase mode. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional features --------------------------------------------------------------
# Enables "Expand my notes" and screenshot import. Server only.
ANTHROPIC_API_KEY=
# Model used for the AI features. Blank = claude-haiku-4-5-20251001
LLM_MODEL=
# Max AI calls per user per calendar month. Blank = 100
AI_MONTHLY_CAP=
# Enables YouTube length and publish date. Without it, titles come from oEmbed and you enter the length.
YOUTUBE_API_KEY=
# Error monitoring. Blank = off.
SENTRY_DSN=

# --- Link reading -------------------------------------------------------------------
# Published in the bot's User-Agent so site owners can contact you. A URL or an email address
# for a mailbox you are happy to publish. Blank = "contact-not-set".
CPD_BOT_CONTACT=
# Link reads per user per hour (per server instance). Blank = 30
EXTRACT_RATE_LIMIT_PER_HOUR=

# --- Local demo mode ----------------------------------------------------------------
# Allowed when NODE_ENV is not "production". Set to true to allow it in production (not recommended).
CPD_LOCAL_MODE=
# Where the demo JSON database lives. Blank = .data/local-db.json
CPD_LOCAL_DB=
